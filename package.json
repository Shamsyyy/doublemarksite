{
  "name": "doublemark-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DoubleMark marketing and account web platform",
  "scripts": {
    "dev": "vite",
    "downloads:sync": "node scripts/sync-download-manifest.mjs",
    "build": "npm run downloads:sync && tsc -b && vite build",
    "lint": "eslint src",
    "preview": "vite preview",
    "security:check": "node scripts/check-secrets.js",
    "release:check": "node scripts/release-check.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
